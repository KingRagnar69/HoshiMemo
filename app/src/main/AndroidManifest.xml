<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HoshiMemo"
        android:name=".HoshiApp">

        <!-- AdMob App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7539583464292210~9937357896"/>

        <!-- ── Default launcher (always present) ─────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HoshiMemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
        ╔══════════════════════════════════════════════════════════════╗
        ║               SECRET ALTERNATE ICONS                        ║
        ║                                                              ║
        ║  Each alias below points to MainActivity but uses a         ║
        ║  different launcher icon. All start DISABLED — the          ║
        ║  SecretScreen enables exactly one at a time via             ║
        ║  PackageManager.setComponentEnabledSetting().               ║
        ║                                                              ║
        ║  TO COMPLETE SETUP IN ANDROID STUDIO:                       ║
        ║  1. Create ic_launcher_gothic.png  (all mipmap- densities)  ║
        ║  2. Create ic_launcher_dragon.png  (all mipmap- densities)  ║
        ║  3. Create ic_launcher_scifi.png   (all mipmap- densities)  ║
        ║  4. Place them in res/mipmap-*/    (hdpi/xhdpi/xxhdpi/xxxhdpi)
        ╚══════════════════════════════════════════════════════════════╝
        -->

        <!-- Icon 1 — Gothic Noir 🕸️ -->
        <activity-alias
            android:name=".MainActivityGothicIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gothic"
            android:roundIcon="@mipmap/ic_launcher_gothic"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Icon 2 — Dragon's Hoard 🐉 -->
        <activity-alias
            android:name=".MainActivityDragonIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dragon"
            android:roundIcon="@mipmap/ic_launcher_dragon"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Icon 3 — Void Rift 🛸 -->
        <activity-alias
            android:name=".MainActivitySciFiIcon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_scifi"
            android:roundIcon="@mipmap/ic_launcher_scifi"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>